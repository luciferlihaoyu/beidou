# JWT 签名密钥（必填，生产环境用长随机串）
SECRET_KEY=please-change-me-to-a-long-random-string

# SSO 联邦登录密钥（P1-3，可选）：TIANGONG_SSO_SECRET 必须与天宫侧一致——
# 天宫配置了 TIANGONG_SSO_SECRET 就用同值；天宫未配置（回退 APP_SECRET）时，
# 此处须配天宫的 APP_SECRET 同值。留空 = 未配置，/sso/launch 返回 501「SSO 未配置」。
TIANGONG_SSO_SECRET=

# 首次启动创建的默认管理员（仅在数据库为空时生效）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 数据目录（SQLite 文件存放处）
DATA_DIR=./data

# 服务端口
PORT=3000
