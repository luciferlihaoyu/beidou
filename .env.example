# ===== 北斗环境变量模板 =====
# 用法：cp .env.example .env 后按下述说明填写。生产模式（BEIDOU_ENV=production，
# docker-compose.yml 与 Dockerfile 均已固化）会对凭据做门禁检查。

# JWT 签名密钥（**必填**）：用 `openssl rand -hex 32` 生成 64 位十六进制串后粘贴于此。
# 留空、或沿用仓库里的示例值（如 please-change-me-...）、或常见弱口令，
# 在生产环境会被**拒绝启动**——因为这些值已随源码公开，等于没有密钥。
SECRET_KEY=

# 弱凭据放行开关（**仅供历史部署临时保命**，默认关闭）：
# 生产环境若检测到"已公开/未设置"的凭据会拒绝启动；确实无法立即更换时，
# 设 1 可放行，但启动时会持续打印 ERROR 日志（便于监控发现）。
# 取值：1/true/yes/on 为启用，其余（含留空）一律视为关闭。换好密钥后请立刻撤掉。
ALLOW_WEAK_CREDS=

# 部署环境：compose/Dockerfile 已固化 production，此处无需再设。
# 仅当裸跑 uvicorn 做本地开发时才需要 development（此时门禁只告警不拦截）。
# BEIDOU_ENV=development

# SSO 联邦登录密钥（可选）：TIANGONG_SSO_SECRET 必须与天宫侧一致——
# 天宫配置了 TIANGONG_SSO_SECRET 就用同值；天宫未配置（回退 APP_SECRET）时，
# 此处须配天宫的 APP_SECRET 同值。留空 = 未配置，/sso/launch 返回 501「SSO 未配置」。
TIANGONG_SSO_SECRET=

# 首次启动创建的默认管理员（仅在数据库为空时生效）
# ADMIN_PASSWORD 必填强口令（12 位以上，推荐 16+）：生产环境弱口令拒启，
# 开发环境留空同样拒启——空口令 admin 一旦落库，本地实例即形同裸奔。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 数据目录（SQLite 文件存放处）
DATA_DIR=./data

# 服务端口
PORT=3000
