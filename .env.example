# 北斗 (Beidou) 环境变量配置
# 复制为 .env 并修改

# 应用
APP_NAME=北斗
APP_VERSION=1.0.0
DEBUG=false

# 安全密钥（务必修改！）
# 警告：当 DEBUG=false（生产环境）时，使用占位符密钥或少于 32 字符的密钥会导致启动失败（RuntimeError）。
SECRET_KEY=change-me-to-a-random-string
JWT_SECRET_KEY=change-me-to-another-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 默认管理员（首次启动自动创建）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_EMAIL=admin@beidou.local

# 紧急管理员初始化（默认关闭）
# 仅在紧急场景临时设为 true 以启用 POST /api/auth/init-admin，用后请改回 false。
ALLOW_INIT_ADMIN=false

# 数据库
# 本地开发用 SQLite：
DATABASE_URL=sqlite+aiosqlite:///./data/novelwriter.db
# Zeabur 生产用 PostgreSQL（在 Zeabur 添加 PostgreSQL 后填入连接字符串）：
# DATABASE_URL=postgresql://user:password@host:5432/database

# CORS（前端域名，逗号分隔）
CORS_ORIGINS=["*"]

# 前端 API 地址（Zeabur 部署时设置为后端域名）
# VITE_API_BASE=https://your-backend.zeabur.app/api
